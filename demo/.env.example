# Copy to .env (untracked). run.sh reads it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VGS_CLIENT_ID=
VGS_CLIENT_SECRET=
VGS_VAULT_ID=tntXXXXXXXX
VGS_ENVIRONMENT=sandbox
# Outbound-proxy access credentials (required for payments — Valet sends
# checkout through the VGS forward proxy as these user/pass).
VGS_USERNAME=
VGS_PASSWORD=
# Optional — run.sh generates these if unset:
# DEMO_PASSWORD=
# VALET_MASTER_PASSWORD=
# VALET_OWNER_TOKEN=
# DEMO_CARD_LABEL=personal
